<header>
  {% unless page.permalink == '/' %}
    <div class="minimal-site-header">
      <div class="container minimal-site-header-row">
        <a class="minimal-home-link" href="{{ '/' | relative_url }}" aria-label="Return to Haolei Bai's homepage">
          <span aria-hidden="true">←</span> Haolei Bai
        </a>
        {% include site_utilities.liquid %}
      </div>
    </div>
  {% endunless %}
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
